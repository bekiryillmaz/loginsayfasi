@page "/registration"
@using loginsayfasi.Models;
<h3>Kayıt Ol</h3>

<EditForm Model="@registrationModel" OnInvalidSubmit="Submit">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label>Ad</label>
        <input @bind-value="registrationModel.FirstName" class="form-control" placeholder="Adınızı girin">
        <ValidationMessage For="@(() => registrationModel.FirstName)" />
    </div>

    <div class="form-group">
        <label>Soyad</label>
        <input @bind-value="registrationModel.LastName" class="form-control" placeholder="Soyadınızı girin">
        <ValidationMessage For="@(() => registrationModel.LastName)" />
    </div>

    <div class="mt-2 form-group">
        <label>Cinsiyet</label>
        <div class="d-flex flex-row">
            <div class="col-3 d-flex justify-content-between">
                <div class="form-check">
                    <input @onchange="@(() => registrationModel.Gender = "male")" class="form-check-input" type="radio" name="flexRadioDefault">
                    <label class="form-check-label" for="flexRadioDefault1">
                        Erkek
                    </label>
                </div>
                <div class="form-check">
                    <input @onchange="@(() => registrationModel.Gender = "female")" class="form-check-input" type="radio" name="flexRadioDefault">
                    <label class="form-check-label" for="flexRadioDefault2">
                        Kadın
                    </label>
                </div>
            </div>
        </div>
        <ValidationMessage For="@(() => registrationModel.Gender)" />
    </div>

    <div class="form-group">
        <label>Email Adresi</label>
        <input type="email" @bind-value="registrationModel.Email" class="form-control" placeholder="Email adresinizi girin">
        <ValidationMessage For="@(() => registrationModel.Email)" />
    </div>

    <div class="mt-2 form-group">
        <label>Şifre</label>
        <input type="password" @bind-value="registrationModel.Password" class="form-control" placeholder="Şifrenizi girin">
        <ValidationMessage For="@(() => registrationModel.Password)" />
    </div>

    <div class="mt-2 text-end">
        <NavLink class="nav-link" href="/">
            <span>Zaten bir hesabınız var mı?</span>
        </NavLink>
    </div>

    <div class="text-center mt-2">
        <button class="btn btn-primary" type="submit">Kayıt Ol</button>
    </div>
</EditForm>

@code {
    RegistrationModel registrationModel = new();

    private void Submit()
    {
        // Kayıt işlemleri burada yapılacak
    }
}
