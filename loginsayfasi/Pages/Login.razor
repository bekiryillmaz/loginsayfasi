@page "/"
@using loginsayfasi.Models;
<h3>Giriş Yap</h3>

<EditForm Model="@loginModel" OnInvalidSubmit="Submit">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>Email Adresi</label>
        <input type="email" @bind-value="loginModel.UserName" class="form-control" placeholder="Email girin">
        <ValidationMessage For="@(() => loginModel.UserName)" />
    </div>

    <div class="mt-2 form-group">
        <label>Şifre</label>
        <input type="password" @bind-value="loginModel.Password" class="form-control" placeholder="Şifrenizi girin">
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <div class="mt-2 text-end">
        <NavLink class="nav-link" href="registration">
            <span>Yeni bir hesap oluşturmak ister misiniz?</span>
        </NavLink>
    </div>

    <div class="text-center mt-2">
        <button class="btn btn-primary" type="submit">
            <span class="@_spinnerClass" role="status" aria-hidden="true"></span>
            Giriş Yap
        </button>
    </div>
</EditForm>

@code {
    LoginModel loginModel = new();

    private string _spinnerClass = "";

    private async void Submit()
    {
        _spinnerClass = "spinner-border spinner-border-sm";
        await Task.Delay(500);
        _spinnerClass = "";
        StateHasChanged();
    }
}
